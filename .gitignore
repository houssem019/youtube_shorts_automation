# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ---------- Editors / OS ----------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Secrets (never commit) ----------
client_secrets.json
credentials.json
token.json
*.json.bak
.env

# ---------- Runtime state and logs (created by main.py) ----------
data/*
!data/.gitkeep
*.log

# ---------- Media ----------
# Background music for the plain render: bring your own, mostly copyrighted.
assets/music/*
!assets/music/.gitkeep
*.mp4
*.mp3
edits/

# ---------- Video editor: downloaded / generated ----------
video_editor/.venv/
video_editor/models/
video_editor/studio/node_modules/
video_editor/studio/out/
